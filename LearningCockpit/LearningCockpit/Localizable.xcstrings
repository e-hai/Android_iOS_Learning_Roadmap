    "stage.architecture.goal" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same shape on both sides: MVVM + Repository."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两端几乎同一套：MVVM + Repository。"
          }
        }
      }
    },
    "stage.architecture.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android: UI → ViewModel → Repository → DataSource → Network/DB\niOS: View → ViewModel → Repository → Service → API/Store"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android: UI → ViewModel → Repository → DataSource → Network/DB\niOS: View → ViewModel → Repository → Service → API/Store"
          }
        }
      }
    },
    "stage.architecture.note.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep View thin: bind state, send intents"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "View 保持瘦：只绑状态、发意图"
          }
        }
      }
    },
    "stage.architecture.note.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep network/DB details in Repository, not View"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络/数据库细节进 Repository，不要堆在 View"
          }
        }
      }
    },
    "stage.architecture.note.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ViewModels often use @Observable + @MainActor without a base class"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ViewModel 常用 @Observable + @MainActor，不一定继承基类"
          }
        }
      }
    },
    "stage.architecture.practice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build list + detail + local favorites + network refresh with the same architecture."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用同一架构完成「列表 + 详情 + 收藏（本地）+ 网络刷新」。"
          }
        }
      }
    },
