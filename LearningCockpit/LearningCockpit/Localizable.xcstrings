    "stage.language.goal" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk Kotlin topics, then Swift. Biggest pitfall: Swift favors value types (struct) + ARC."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按同一主题顺序过 Kotlin，再对照 Swift。迁移最大坑：Swift 以值类型（struct）+ ARC 为主。"
          }
        }
      }
    },
    "stage.language.note.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefer struct for UI State / Model; use class / @Observable for shared mutable state"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先用 struct 建模 UI State / Model；需要共享可变状态再用 class / @Observable"
          }
        }
      }
    },
    "stage.language.note.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch retain cycles when closures capture self"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闭包捕获 self 时警惕循环引用"
          }
        }
      }
    },
    "stage.language.note.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "enum associated values ≈ many sealed class cases"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "enum 关联值 ≈ 很多 sealed class 场景"
          }
        }
      }
    },
    "stage.language.note.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android leans on inheritance; iOS leans on Protocol + Extension"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android 更常用继承；iOS 更常用 Protocol + Extension"
          }
        }
      }
    },
    "stage.language.practice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write User / Result / Repository in Swift; compare struct vs class copy behavior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Swift 写一套 User / Result / Repository 协议，刻意对比 struct 与 class 的拷贝行为。"
          }
        }
      }
