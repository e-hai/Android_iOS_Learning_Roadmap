      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android lifecycle is finer-grained; SwiftUI mostly uses onAppear / onDisappear + scenePhase."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android 生命周期更细；SwiftUI 多用 onAppear / onDisappear + scenePhase。"
          }
        }
      }
    },
    "stage.lifecycle.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android: Application → Activity → Fragment → View\niOS: App → Scene → View (system manages Window)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android: Application → Activity → Fragment → View\niOS: App → Scene → View 层级（Window 由系统管理）"
          }
        }
      }
    },
    "stage.lifecycle.note.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don’t map Activity callbacks 1:1 onto SwiftUI"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要把 Activity 回调一对一硬套到 SwiftUI"
